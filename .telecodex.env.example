# Copy to .telecodex.env and fill in. This file is the only supported place to
# put credentials; .telecodex.env is gitignored.
#
# Read SECURITY.md before running this on a machine you care about.

# Required. Token from @BotFather.
# TELEGRAM_BOT_TOKEN=1234567890:replace-me

# Required. Comma-separated Telegram numeric user ids. This allowlist is the
# ONLY authentication boundary in the system. Leave it empty and nothing runs;
# put the wrong id in it and that person gets your Codex process.
# TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional. Override only if you front the Bot API with your own endpoint.
# TELEGRAM_API_BASE=https://api.telegram.org

# Optional. mention-or-reply (default) | all-authorized
# In groups, all-authorized still runs after the allowlist check above.
# TELEGRAM_GROUP_TRIGGER_MODE=mention-or-reply

# Optional: TeleCodex uses your existing `codex login` by default.
# Set CODEX_API_KEY only if you want API-key auth instead.
# CODEX_API_KEY=

# Optional Codex defaults
# CODEX_MODEL=gpt-5.4

# Backend: bridge and desktop CLI share one long-lived app-server writer.
CODEX_BACKEND=app-server
# Defaults to <repo>/.telecodex/run/app-server.sock; set only to relocate it.
# Do not place it on a network share or a cloud-synced folder.
# CODEX_APP_SERVER_SOCKET=
CODEX_THREAD_IDLE_TIMEOUT_MS=3600000

# Sandbox and approvals. read-only | workspace-write | danger-full-access.
# workspace-write is the Codex default and the default here. Anything a message
# in an allowlisted chat asks for runs with these privileges, including text
# that the model read out of a file or a web page. danger-full-access on a
# personal machine means one prompt injection owns the machine.
CODEX_SANDBOX_MODE=workspace-write
# Only never is supported. This bridge has no approval interaction; other
# values are rejected at startup. Adding approvals requires implementing the
# request/response flow in a fork. Use the sandbox mode to set execution scope.
CODEX_APPROVAL_POLICY=never

# Telegram/UI behavior
TOOL_VERBOSITY=none
SHOW_TURN_TOKEN_USAGE=false
ENABLE_TELEGRAM_REACTIONS=false

# Core/worker split. Additional workers override TELECODEX_BOT_KEY and the
# token in .telecodex/instances/<botKey>/bot.env.
TELECODEX_BOT_KEY=main
# Both default to paths under <repo>/.telecodex/; set only to relocate them.
# TELECODEX_CORE_SOCKET=
# TELECODEX_STATE_DB=

# Optional runtime paths. Loaded before setup, service startup, and CLI probes.
# TELECODEX_NODE_BIN=/absolute/path/to/node
# TELECODEX_CODEX_BIN=/absolute/path/to/codex
