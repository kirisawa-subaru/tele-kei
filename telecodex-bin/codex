#!/usr/bin/env bash
# Repo-local Codex CLI shim. Everything in this repository that needs `codex`
# goes through here, so the version can never drift with the operator's PATH.
#
# Resolution order:
#   1. TELECODEX_CODEX_BIN   — an existing Codex CLI you want to use as is
#   2. .vendor/codex/        — the pin installed by ./telecodex.pin-codex.sh
#
# There is deliberately no fallback to `codex` on PATH: this file is itself
# prepended to PATH as `codex`, and a PATH lookup would recurse.

set -euo pipefail

SELF="$0"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *) SELF="$(dirname "$SELF")/$link" ;;
  esac
done
ROOT="${TELECODEX_ROOT:-$(cd "$(dirname "$SELF")/.." && pwd)}"

if [ -n "${TELECODEX_CODEX_BIN:-}" ]; then
  if [ ! -x "$TELECODEX_CODEX_BIN" ]; then
    echo "[telecodex-codex] TELECODEX_CODEX_BIN is not an executable: $TELECODEX_CODEX_BIN" >&2
    exit 1
  fi
  exec "$TELECODEX_CODEX_BIN" "$@"
fi

TELECODEX_ROOT="$ROOT"
# shellcheck source=../telecodex.runtime.sh
. "$ROOT/telecodex.runtime.sh"

if ! CODEX_JS="$(telecodex_pin_codex_js)"; then
  echo "[telecodex-codex] no pinned Codex snapshot under $TELECODEX_PIN_ROOT" >&2
  echo "[telecodex-codex] run ./telecodex.pin-codex.sh, or export TELECODEX_CODEX_BIN" >&2
  exit 1
fi

if ! NODE_BIN="$(telecodex_pin_node_bin)"; then
  telecodex_resolve_node
  NODE_BIN="$TELECODEX_NODE_BIN"
fi

exec "$NODE_BIN" "$CODEX_JS" "$@"
